<Window x:Class="Lunaris.UI.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lunaris.UI.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="700"
        ShowActivated="True"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border x:Name="Card"
            CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Margin="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search row -->
            <Grid Margin="18,16,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                           FontSize="18" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Margin="12,0,10,0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         FontSize="{Binding FontSize}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         SpellCheck.IsEnabled="False"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="18,0"/>

            <!-- Results -->
            <Grid Grid.Row="2" Margin="10,8,10,10">
                <ListBox x:Name="ResultsList"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                         ItemTemplate="{StaticResource SearchResultTemplate}"
                         MaxHeight="436"
                         FontSize="{Binding FontSize}"/>
            </Grid>
        </Grid>
    </Border>
</Window>