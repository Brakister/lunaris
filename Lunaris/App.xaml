<Application x:Class="Lunaris.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Lunaris.UI.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Themes/Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
            <converters:StringEqualsToBoolConverter x:Key="StringEqualsToBool"/>
            <converters:DoubleEqualsToBoolConverter x:Key="DoubleEqualsToBool"/>

            <DataTemplate x:Key="SearchResultTemplate">
                <Grid Margin="4,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30" CornerRadius="8"
                            Background="{DynamicResource SecondarySurfaceBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="&#xE734;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="{DynamicResource StarBrush}"
                               VerticalAlignment="Center" Margin="8,0,2,0"
                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>